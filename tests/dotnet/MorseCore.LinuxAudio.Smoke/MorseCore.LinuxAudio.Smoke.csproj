    <Compile Include="../../../apps/MorseCore.Desktop/MorseCore.Desktop/MorseAudioCapture.cs" Link="MorseAudioCapture.cs" />
    <Compile Include="../../../apps/MorseCore.Desktop/MorseCore.Desktop/SpeechService.cs" Link="SpeechService.cs" />
  </ItemGroup>
</Project>
