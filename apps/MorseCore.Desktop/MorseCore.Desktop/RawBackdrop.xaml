<UserControl x:Class="MorseCore.Desktop.RawBackdrop"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
 <UserControl.Resources>
  <LinearGradientBrush x:Key="OliveTL" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8D9479" Offset="0"/><GradientStop Color="#A9AE96" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="OliveTR" StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#949A80" Offset="0"/><GradientStop Color="#B2B6A0" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="OliveBL" StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#7F876C" Offset="0"/><GradientStop Color="#A3A891" Offset="1"/></LinearGradientBrush>
 </UserControl.Resources>
 <!-- Geometry and corner proportions adapted from RAW Akademi's SiteBackdrop.tsx.
      Only the four outer layers move; paths and dash patterns remain static. -->
