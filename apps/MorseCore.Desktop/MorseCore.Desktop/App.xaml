<Application x:Class="MorseCore.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
   </ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="CanvasBrush" Color="#FAF8F2"/>
     <SolidColorBrush x:Key="PaneBrush" Color="#FAF9F7"/>
     <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="InkBrush" Color="#2C2A22"/>
     <SolidColorBrush x:Key="MutedBrush" Color="#78716C"/>
     <SolidColorBrush x:Key="LineBrush" Color="#E7E4DF"/>
     <SolidColorBrush x:Key="AccentBrush" Color="#5E6A42"/>
     <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F5E6A42"/>
     <SolidColorBrush x:Key="AccentInkBrush" Color="#4E5836"/>
     <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F5E6A42"/>
     <SolidColorBrush x:Key="NavSelectedInkBrush" Color="#4E5836"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="CanvasBrush" Color="#46513B"/>
     <SolidColorBrush x:Key="PaneBrush" Color="#5E6A42"/>
     <SolidColorBrush x:Key="CardBrush" Color="#536048"/>
     <SolidColorBrush x:Key="InkBrush" Color="#FAF8F2"/>
     <SolidColorBrush x:Key="MutedBrush" Color="#E1E6D8"/>
     <SolidColorBrush x:Key="LineBrush" Color="#A7B596"/>
     <SolidColorBrush x:Key="AccentBrush" Color="#5E6A42"/>
     <SolidColorBrush x:Key="AccentSoftBrush" Color="#75845D"/>
     <SolidColorBrush x:Key="AccentInkBrush" Color="#F0F4E7"/>
     <SolidColorBrush x:Key="NavSelectedBrush" Color="#FAF8F2"/>
     <SolidColorBrush x:Key="NavSelectedInkBrush" Color="#4E5836"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Color x:Key="SystemAccentColor">#5E6A42</Color>
   <Color x:Key="SystemAccentColorDark1">#4E5836</Color>
   <Color x:Key="SystemAccentColorDark2">#4E5836</Color>
   <Color x:Key="SystemAccentColorDark3">#4E5836</Color>
   <Color x:Key="SystemAccentColorLight1">#5E6A42</Color>
   <Color x:Key="SystemAccentColorLight2">#5E6A42</Color>
   <Color x:Key="SystemAccentColorLight3">#5E6A42</Color>

   <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible</FontFamily>
   <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/CrimsonPro.ttf#Crimson Pro</FontFamily>
   <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
   </Style>
   <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
    <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
   </Style>
   <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinWidth" Value="190"/>
    <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
   </Style>
   <Style TargetType="NumberBox">
    <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
